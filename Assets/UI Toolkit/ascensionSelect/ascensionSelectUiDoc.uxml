<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/common.uss?fileID=7433441132597879392&amp;guid=8d0bc28a2ed710a44b762e4c857ac6f9&amp;type=3#common" />
    <Style src="project://database/Assets/fontStyling.uss?fileID=7433441132597879392&amp;guid=d0c0881f1c32747ecb649373600de095&amp;type=3#fontStyling" />
    <Style src="project://database/Assets/UI%20Toolkit/Stylesheets/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=acefe7eb60f7cac43a283bde6352a710&amp;type=3#ButtonStyle" />
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(0, 0, 0); align-self: center; align-items: center; justify-content: center; -unity-background-image-tint-color: rgb(212, 212, 212); overflow: hidden;">
        <ui:VisualElement name="environmentArt" style="flex-grow: 1; width: 125%; height: 125%; position: absolute; top: -17px;">
            <ui:VisualElement name="hotelLobbyBack" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Sprites/Environments/HotelLobbyReviseBack2.png?fileID=2800000&amp;guid=ba70f47cb16de0c4c96fe7caa611a447&amp;type=3#HotelLobbyReviseBack2&quot;);" />
            <ui:VisualElement name="concierge" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/Sprites/Companions/Tiefseeker.png?fileID=2800000&amp;guid=58ef131cacccc4f4f88a8faa950137de&amp;type=3#Tiefseeker&quot;); -unity-background-scale-mode: scale-to-fit; width: 63%; height: 67%; left: 184px; top: 243px;" />
            <ui:VisualElement name="hotelLobbyFront" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Sprites/Environments/HotelLobbyReviseFront2.png?fileID=2800000&amp;guid=cda92d128204b4f428b606bc6555f36c&amp;type=3#HotelLobbyReviseFront2&quot;);" />
        </ui:VisualElement>
        <ui:Label tabindex="-1" text="We are so here yippe yippee yayaya" parse-escape-sequences="true" display-tooltip-when-elided="true" />
        <ui:VisualElement name="ascensionDisplay" style="flex-grow: 1; width: 758px; height: 410px; left: 984px; position: absolute; top: 282px;">
            <ui:Button name="leftArrow" class="focusable" style="position: absolute; width: 127px; height: 127px; top: 106px; left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                <ui:VisualElement name="leftArrowImage" picking-mode="Ignore" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Sprites/UI/Map/ARROW%20MAP.png?fileID=2800000&amp;guid=e61466a3ca0442f47b884ca6973fa902&amp;type=3#ARROW MAP&quot;); rotate: 90deg;" />
            </ui:Button>
            <ui:VisualElement name="textContainer" style="flex-grow: 1; position: absolute; width: 467px; height: 210px; top: 58px; left: 147px; flex-direction: column; background-image: url(&quot;project://database/Assets/Sprites/UI/MultiDeckView/Multiscreen_Exit_Button.png?fileID=2800000&amp;guid=4c51223a65a23bc48a47dcac7cea9c37&amp;type=3#Multiscreen_Exit_Button&quot;);">
                <ui:Label tabindex="-1" text="Stake 0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="stakeNumber" style="font-size: 48px; -unity-text-align: upper-center; top: 43px; position: absolute; left: 57px; width: 345px;" />
                <ui:Label tabindex="-1" text="Enemies Are Healthier" parse-escape-sequences="true" display-tooltip-when-elided="true" name="stakeDescription" style="left: 50px; width: 353px; -unity-text-align: upper-center; top: 105px; font-size: 24px;" />
            </ui:VisualElement>
            <ui:Button name="rightArrow" class="focusable" style="position: absolute; width: 127px; height: 127px; top: 106px; right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                <ui:VisualElement name="rightArrowImage" picking-mode="Ignore" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Sprites/UI/Map/ARROW%20MAP.png?fileID=2800000&amp;guid=e61466a3ca0442f47b884ca6973fa902&amp;type=3#ARROW MAP&quot;); rotate: -90deg; scale: -1 1;" />
            </ui:Button>
            <ui:Button text="Play!" parse-escape-sequences="true" display-tooltip-when-elided="true" name="startButton" class="main-menu-button focusable main-menu-button-size" style="position: absolute; left: 50%; bottom: -1px; width: 387px; height: 98px; translate: -50% 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
