.entity-view-status-indicator {
    flex-grow: 0;
    background-color: rgb(27, 27, 27);
    flex-shrink: 0;
    height: 24%;
    translate: -70% 0;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    margin-top: 4px;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 4px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-left-color: rgb(97, 69, 11);
    border-right-color: rgb(97, 69, 11);
    border-top-color: rgb(97, 69, 11);
    border-bottom-color: rgb(97, 69, 11);
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    width: 30%;
}

.entity-view-status-indicator-icon {
    flex-grow: 0;
    background-image: url("project://database/Assets/Sprites/Z_OldPlaceholderSprites/bicep.png?fileID=2800000&guid=ed55b8c3c8cddf84e9879c69c720553a&type=3#bicep");
    flex-direction: column;
    height: 85%;
    width: 41%;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.entity-view-status-indicator-label {
    -unity-font-style: bold;
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(255, 255, 255);
}

.entity-view-health-bar-shield-indicator {
    position: absolute;
    left: -22%;
    top: -40%;
    width: 55%;
    height: 170%;
    display: none;
}

.entity-view-health-bar-shield-icon {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/CardIcons-New/CardEffect_Defense-Opaque.png?fileID=2800000&guid=19cc641e6717341e8adb01b927513f58&type=3#CardEffect_Defense-Opaque");
}

.entity-view-health-bar-shield-label {
    -unity-text-align: middle-center;
    width: 100%;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-font-style: bold;
}

.entity-view-health-bar-fill {
    background-image: url("project://database/Assets/Sprites/entityFrames/Companion/frames-DBF/Background_HealthBar.png?fileID=2800000&guid=5a6279273d32f4749ba8ea42dfd98e33&type=3#Background_HealthBar");
}

.entity-view-health-bar-fill-shielded {
    background-image: url("project://database/Assets/Sprites/entityFrames/Enemy/Background_HealthBar-editing.png?fileID=2800000&guid=6741eb367a9fc4de8be2776dfc690c98&type=3#Background_HealthBar-editing");
}
